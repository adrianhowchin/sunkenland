FROM adrianhowchin/wine-steamcmd:latest

RUN mkdir /opt/sunkenland
WORKDIR /opt/sunkenland

# Install the Sunkenland Dedicated Server from Steam
RUN for i in 1 2 3 4 5 6 7 8; do \
      steamcmd +@sSteamCmdForcePlatformType windows \
               +login anonymous \
               +app_info_update 1 \
               +app_update 2667530 validate \
               +quit && exit 0; \
      echo "steamcmd attempt $i failed, retrying..."; sleep 5; \
    done; exit 1

# Copy in the server start script
COPY server_start.sh .
RUN chmod a+x server_start.sh
RUN dos2unix server_start.sh

# The command that runs on container start
CMD ["/opt/sunkenland/server_start.sh"]

EXPOSE 27015
